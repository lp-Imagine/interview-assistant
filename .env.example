# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_interview

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# ── LLM（问答 / 题目生成）──
# 后端 qa.service.ts / generation.service.ts 读取的是 LLM_API_KEY / LLM_BASE_URL
# （兼容 OpenAI 协议的任何端点，如 OpenAI、DeepSeek、Moonshot、火山方舟等）
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1

# ── Embedding（RAG 向量化）──
# rag.service.ts 读取 EMBEDDING_API_KEY / EMBEDDING_BASE_URL
EMBEDDING_API_KEY=sk-your-key-here
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# App
PORT=3000
JWT_SECRET=change-me-to-a-random-string
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
